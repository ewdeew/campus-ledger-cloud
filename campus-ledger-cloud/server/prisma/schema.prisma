generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"   // 想零配置可改成 "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  records      Record[]
  budgets      Budget[]
}

model Record {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "income" | "expense"
  category  String
  amount    Int      // 单位：分
  note      String?
  date      DateTime
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model Budget {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month     String   // "YYYY-MM"
  amount    Int      // 单位：分
  updatedAt DateTime @updatedAt

  @@unique([userId, month])
}
